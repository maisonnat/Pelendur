{
  "productName": "Pelendur Overlay",
  "version": "0.1.0",
  "identifier": "com.pelendur.overlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pelendur HUD",
        "width": 800,
        "height": 400,
        "x": 560,
        "y": 50,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": true
      },
      {
        "label": "profile",
        "url": "tauri://localhost/ui-profile/index.html",
        "title": "Pelendur - Profile Management",
        "width": 900,
        "height": 700,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
