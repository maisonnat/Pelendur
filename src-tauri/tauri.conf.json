{
  "productName": "Pelendur Overlay",
  "version": "0.1.0",
  "identifier": "com.pelendur.overlay",
  "build": {
    "devUrl": "../ui",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pelendur HUD",
        "width": 800,
        "height": 400,
        "x": 560,
        "y": 50,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
