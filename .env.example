# ==========================================
# GhostAI Pilot Configuration
# ==========================================

# --- STT Provider ---
# Options: local (Parakeet ONNX or whisper.cpp), groq, zai
STT_PROVIDER=local

# --- Local whisper.cpp settings ---
WHISPER_MODEL_PATH=C:/path/to/whisper.cpp/models/ggml-tiny.en.bin
WHISPER_LANGUAGE=en
WHISPER_BIN=C:/path/to/whisper.cpp/build/bin/Release/whisper-cli.exe

# --- Parakeet ONNX (local STT) ---
# Model directory (auto-created, models download on first run)
# PARAKEET_MODEL_DIR=~/.local/share/pelendur/models/parakeet

# --- LLM Settings (Ollama local) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:4b-instruct
OPENAI_API_KEY=ollama

# --- Audio Configuration ---
# Audio capture mode: auto (default), polling (Windows), pulseaudio (Linux)
AUDIO_MODE=auto